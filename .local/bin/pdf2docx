#!/usr/bin/env bash

VENV_BIN="$HOME/.local/share/pdfmerge/venv/bin/pdf2docx"

# ---------- VALIDATION ----------
if [ $# -eq 0 ]; then
    echo "Usage:"
    echo "  pdf2docx input.pdf"
    echo "  pdf2docx input.pdf output.docx"
    echo "  pdf2docx -all file1.pdf file2.pdf ..."
    exit 1
fi

# ---------- MODE: BATCH ----------
if [ "$1" = "-all" ]; then
    shift

    if [ $# -lt 1 ]; then
        echo "Error: no files provided for -all"
        exit 1
    fi

    for file in "$@"; do
        if [[ "$file" != *.pdf ]]; then
            echo "Skipping (not pdf): $file"
            continue
        fi

        if [ ! -f "$file" ]; then
            echo "Skipping (not found): $file"
            continue
        fi

        out="${file%.pdf}.docx"

        echo "[CONVERT] $file → $out"
        "$VENV_BIN" convert "$file" -o "$out"
    done

    exit 0
fi

# ---------- MODE: SINGLE ----------
if [ $# -eq 1 ]; then
    INPUT="$1"

    if [[ "$INPUT" != *.pdf ]]; then
        echo "Error: input must be .pdf"
        exit 1
    fi

    if [ ! -f "$INPUT" ]; then
        echo "Error: file not found"
        exit 1
    fi

    OUTPUT="${INPUT%.pdf}.docx"

    exec "$VENV_BIN" convert "$INPUT" -o "$OUTPUT"
fi

# ---------- MODE: SINGLE WITH OUTPUT ----------
if [ $# -eq 2 ]; then
    INPUT="$1"
    OUTPUT="$2"

    if [[ "$INPUT" != *.pdf ]]; then
        echo "Error: input must be .pdf"
        exit 1
    fi

    if [ ! -f "$INPUT" ]; then
        echo "Error: file not found"
        exit 1
    fi

    exec "$VENV_BIN" convert "$INPUT" -o "$OUTPUT"
fi

# ---------- INVALID ----------
echo "Error: invalid usage"
exit 1
