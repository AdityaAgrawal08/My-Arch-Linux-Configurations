#!/usr/bin/env bash

# ---------- VALIDATION ----------
if [ $# -eq 0 ]; then
    echo "Usage:"
    echo "  docx2pdf input.docx"
    echo "  docx2pdf input.docx output.pdf"
    echo "  docx2pdf -all file1.docx file2.docx ..."
    exit 1
fi

# ---------- FUNCTION ----------
convert_file() {
    local input="$1"
    local output="$2"

    # LibreOffice always writes to same dir
    libreoffice --headless --convert-to pdf "$input" >/dev/null 2>&1

    local generated="${input%.docx}.pdf"

    # Rename if custom output requested
    if [ "$generated" != "$output" ]; then
        mv "$generated" "$output"
    fi
}

# ---------- MODE: BATCH ----------
if [ "$1" = "-all" ]; then
    shift

    if [ $# -lt 1 ]; then
        echo "Error: no files provided for -all"
        exit 1
    fi

    for file in "$@"; do
        if [[ "$file" != *.docx ]]; then
            echo "Skipping (not docx): $file"
            continue
        fi

        if [ ! -f "$file" ]; then
            echo "Skipping (not found): $file"
            continue
        fi

        out="${file%.docx}.pdf"

        echo "[CONVERT] $file → $out"
        convert_file "$file" "$out"
    done

    exit 0
fi

# ---------- MODE: SINGLE ----------
if [ $# -eq 1 ]; then
    INPUT="$1"

    if [[ "$INPUT" != *.docx ]]; then
        echo "Error: input must be .docx"
        exit 1
    fi

    if [ ! -f "$INPUT" ]; then
        echo "Error: file not found"
        exit 1
    fi

    OUTPUT="${INPUT%.docx}.pdf"

    convert_file "$INPUT" "$OUTPUT"
    exit 0
fi

# ---------- MODE: SINGLE WITH OUTPUT ----------
if [ $# -eq 2 ]; then
    INPUT="$1"
    OUTPUT="$2"

    if [[ "$INPUT" != *.docx ]]; then
        echo "Error: input must be .docx"
        exit 1
    fi

    if [ ! -f "$INPUT" ]; then
        echo "Error: file not found"
        exit 1
    fi

    convert_file "$INPUT" "$OUTPUT"
    exit 0
fi

# ---------- INVALID ----------
echo "Error: invalid usage"
exit 1
