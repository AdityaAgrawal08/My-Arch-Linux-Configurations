#!/usr/bin/env bash
set -euo pipefail

# ================= CONFIG =================
[ -f "$HOME/.config/trash-system/env" ] && source "$HOME/.config/trash-system/env"

BASE="${TRASH_BASE:-$HOME/.local/share/trash-system}"
DB="${TRASH_DB:-$BASE/db/trash.db}"
OBJ="${TRASH_OBJECTS:-$BASE/objects}"
LOCK="$BASE/.lock"

mkdir -p "$BASE" "$OBJ" "$(dirname "$DB")"

# ================= LOCK =================
exec 200>"$LOCK"
flock -n 200 || {
    echo "ERROR: another operation in progress"
    exit 1
}

# ================= UTIL =================

fail() {
    echo "ERROR: $1" >&2
    exit 1
}

get_row_by_prefix() {
    sqlite3 -separator '|' "$DB" "
    SELECT id, original_path, storage_path, hash, size
    FROM trash
    WHERE id LIKE '$1%' AND is_restored=0
    LIMIT 1;"
}

ref_count() {
    sqlite3 "$DB" "
    SELECT COUNT(*) FROM trash
    WHERE storage_path='$1' AND is_restored=0;"
}

safe_delete_object() {
    local path="$1"

    count=$(ref_count "$path")

    if [ "$count" -eq 0 ]; then
        [ -e "$path" ] && rm -rf -- "$path"
    fi
}

verify_object() {
    local path="$1"
    local expected="$2"

    [ ! -f "$path" ] && fail "object missing"

    local actual
    actual=$(sha256sum "$path" | awk '{print $1}')

    [ "$actual" != "$expected" ] && fail "hash mismatch (corruption)"
}

atomic_copy() {
    local src="$1"
    local dst="$2"

    tmp="${dst}.tmp.$$"

    cp -- "$src" "$tmp" || fail "copy failed"
    mv "$tmp" "$dst" || fail "atomic move failed"
}

# ================= COMMANDS =================

case "${1:-}" in

list)
    sqlite3 -column -header "$DB" "
    SELECT ROW_NUMBER() OVER (ORDER BY deletion_time DESC) as no,
           substr(id,1,8) as id,
           filename,
           datetime(deletion_time,'unixepoch'),
           category
    FROM trash
    WHERE is_restored=0
    ORDER BY deletion_time DESC;"
    ;;

search)
    shift
    query="SELECT substr(id,1,8), filename, datetime(deletion_time,'unixepoch'), category
           FROM trash WHERE is_restored=0"

    while [ $# -gt 0 ]; do
        case "$1" in
            --name) query="$query AND filename LIKE '%$2%'" ; shift 2 ;;
            --type) query="$query AND extension='$2'" ; shift 2 ;;
            --cat)  query="$query AND category='$2'" ; shift 2 ;;
            --path) query="$query AND original_path LIKE '%$2%'" ; shift 2 ;;
            --from) query="$query AND deletion_time >= strftime('%s','$2')" ; shift 2 ;;
            --to)   query="$query AND deletion_time <= strftime('%s','$2')" ; shift 2 ;;
            *) shift ;;
        esac
    done

    sqlite3 -column -header "$DB" "$query ORDER BY deletion_time DESC;"
    ;;

delete)
    arg="${2:-}"

    [ -z "$arg" ] && fail "missing id"

    if [[ "$arg" =~ ^[0-9]+-[0-9]+$ ]]; then
        start=${arg%-*}
        end=${arg#*-}

        ids=$(sqlite3 "$DB" "
        SELECT id FROM (
            SELECT id, ROW_NUMBER() OVER (ORDER BY deletion_time DESC) rn
            FROM trash WHERE is_restored=0 AND COALESCE(pinned,0)=0
        ) WHERE rn BETWEEN $start AND $end;")

        [ -z "$ids" ] && fail "empty range"

        read -p "Confirm delete $start-$end? (y/N): " c
        [ "$c" != "y" ] && exit 0

        for id in $ids; do
            path=$(sqlite3 "$DB" "SELECT storage_path FROM trash WHERE id='$id';")

            sqlite3 "$DB" "DELETE FROM trash WHERE id='$id';"

            safe_delete_object "$path"
        done

        echo "Deleted range"
        exit 0
    fi

    row=$(get_row_by_prefix "$arg")
    [ -z "$row" ] && fail "not found or pinned"

    id=$(cut -d'|' -f1 <<< "$row")
    path=$(cut -d'|' -f3 <<< "$row")

    read -p "Delete permanently? (y/N): " c
    [ "$c" != "y" ] && exit 0

    sqlite3 "$DB" "DELETE FROM trash WHERE id='$id';"

    safe_delete_object "$path"

    echo "Deleted"
    ;;

restore)
    row=$(get_row_by_prefix "${2:-}")
    [ -z "$row" ] && fail "not found"

    id=$(cut -d'|' -f1 <<< "$row")
    orig=$(cut -d'|' -f2 <<< "$row")
    store=$(cut -d'|' -f3 <<< "$row")
    hash=$(cut -d'|' -f4 <<< "$row")

    verify_object "$store" "$hash"

    [ -e "$orig" ] && fail "target exists"

    mkdir -p "$(dirname "$orig")"

    atomic_copy "$store" "$orig"

    sqlite3 "$DB" "UPDATE trash SET is_restored=1 WHERE id='$id';"

    echo "Restored"
    ;;

undo)
    id=$(sqlite3 "$DB" "
    SELECT id FROM trash
    WHERE is_restored=0
    ORDER BY deletion_time DESC LIMIT 1;")

    [ -z "$id" ] && exit 0

    "$0" restore "$id"
    ;;

stats)
    sqlite3 "$DB" "
    SELECT COUNT(*), ROUND(SUM(size)/1024/1024,2)
    FROM trash WHERE is_restored=0;"
    ;;

group)
    sqlite3 "$DB" "
    SELECT extension, COUNT(*)
    FROM trash
    WHERE is_restored=0
    GROUP BY extension;"
    ;;

pin)
    sqlite3 "$DB" "UPDATE trash SET pinned=1 WHERE id LIKE '$2%';"
    ;;

unpin)
    sqlite3 "$DB" "UPDATE trash SET pinned=0 WHERE id LIKE '$2%';"
    ;;

*)
    echo "Usage: trash [list|search|delete|restore|undo|stats|group|pin|unpin]"
    exit 1
    ;;

esac
