#!/usr/bin/env bash
[ -f "$HOME/.config/trash-system/env" ] && source "$HOME/.config/trash-system/env"
DB="${TRASH_DB:-$HOME/.local/share/trash-system/db/trash.db}"
BASE="${TRASH_BASE:-$HOME/.local/share/trash-system}"
OBJ="${TRASH_OBJECTS:-$BASE/objects}"

selection=$(sqlite3 -separator '|' "$DB" \
"SELECT 
 id,
 filename,
 original_path,
 datetime(deletion_time,'unixepoch')
 FROM trash
 WHERE is_restored=0
 ORDER BY deletion_time DESC;" | \
fzf --ansi --multi \
    --delimiter='|' \
    --with-nth=2,3,4 \
    --preview 'echo -e "\nFILE:\n{2}\n\nPATH:\n{3}\n\nDELETED:\n{4}"' \
    --preview-window=right:50% \
    --header="ENTER: select | TAB: multi-select | /: search" \
    --bind "ctrl-a:select-all,ctrl-d:deselect-all")

[ -z "$selection" ] && exit 0

echo "[o]pen  [r]estore  [d]elete  [q]skip"
read -r action

while IFS='|' read -r id filename original_path deleted; do

    id=$(echo "$id" | tr -d '[:space:]')

    case "$action" in
        o)
            setsid -f fish -c "open \"$HOME/.local/share/trash-system/objects/*/*/*/*${id}*\"" >/dev/null 2>&1
            ;;
        r)
            ~/.local/bin/trash restore "$id"
            ;;
        d)
            ~/.local/bin/trash delete "$id"
            ;;
        *)
            exit
            ;;
    esac

done <<< "$selection"
