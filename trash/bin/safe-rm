#!/usr/bin/env bash

[ -f "$HOME/.config/trash-system/env" ] && source "$HOME/.config/trash-system/env"

BASE="${TRASH_BASE:-$HOME/.local/share/trash-system}"
DB="${TRASH_DB:-$BASE/db/trash.db}"
OBJ="${TRASH_OBJECTS:-$BASE/objects}"
LOCK="$BASE/.lock"

# Dependency check
for cmd in sqlite3 file flock sha256sum; do
    command -v $cmd >/dev/null 2>&1 || {
        echo "Missing dependency: $cmd"
        exit 1
    }
done

# SQL escape
sql_escape() {
    echo "$1" | sed "s/'/''/g"
}


# Ensure directories + lock
mkdir -p "$OBJ"
mkdir -p "$(dirname "$DB")"

# ================= LOCK =================
exec 200>"$LOCK"
flock -n 200 || {
    echo "ERROR: another operation in progress"
    exit 1
}

for target in "$@"; do
    [ -e "$target" ] || continue

    abs=$(realpath -- "$target" 2>/dev/null) || continue
    name=$(basename -- "$target")
    ts=$(date +%s)
    origin=$(echo "$abs" | cut -d/ -f2)
    project=""
    if [ -d "$(dirname "$target")/.git" ]; then
      project=$(dirname "$target")
    fi
    case "$name" in
        *.*) ext="${name##*.}" ;;
        *) ext="" ;;
    esac

    # Safety guards
    case "$abs" in
        "/"|"/home"|"/usr"|"/etc") continue ;;
        "$BASE"*) continue ;;
    esac

# ================= DIRECTORY HANDLING =================
if [ -d "$target" ]; then
    uuid=$(cat /proc/sys/kernel/random/uuid)
    manifest_dir="$OBJ/manifests"
    mkdir -p "$manifest_dir"

    manifest="$manifest_dir/$uuid.json"
    tmpdir=$(mktemp -d)

    # -------- SAFE COPY --------
    cp -a -- "$target" "$tmpdir/dir" || {
        echo "Directory copy failed"
        rm -rf "$tmpdir"
        continue
    }

    # temp manifest file (no collision)
    manifest_files=$(mktemp "$manifest_dir/XXXX.files")

    # -------- INGEST INTO CAS --------
    while IFS= read -r -d '' f; do
    rel="${f#$tmpdir/dir/}"
    hash=$(sha256sum "$f" | awk '{print $1}')

    hash_dir="$OBJ/${hash:0:2}/${hash:2:2}"
    mkdir -p "$hash_dir"
    dest="$hash_dir/$hash"

    tmp_obj=$(mktemp)
    cp -- "$f" "$tmp_obj"
    if ! mv -n -- "$tmp_obj" "$dest" 2>/dev/null; then
        rm -f "$tmp_obj"
    fi

    echo "$rel|$hash" >> "$manifest_files"
    done < <(find "$tmpdir/dir" -type f -print0)

    # -------- BUILD MANIFEST --------
    if [ -s "$manifest_files" ]; then
        files_json=$(awk -F'|' '{printf "    {\"path\":\"%s\",\"hash\":\"%s\"},\n",$1,$2}' "$manifest_files" | sed '$ s/,$//')
    else
        files_json=""
    fi
    manifest_tmp=$(mktemp "$manifest_dir/XXXX.tmp")
  {
    echo "{"
    echo "  \"type\": \"directory\","
    echo "  \"version\": 1,"
    echo "  \"original_path\": \"$(sql_escape "$abs")\","
    echo "  \"files\": ["
    echo "$files_json"
    echo "  ]"
    echo "}"
  } > "$manifest_tmp"
  mv -f "$manifest_tmp" "$manifest"
  
    rm -f "$manifest_files"
    size=$(du -sb -- "$target" | awk '{print $1}')
    # -------- DB INSERT FIRST (ATOMICITY) --------
    sqlite3 "$DB" "BEGIN;
    INSERT INTO trash (
      id, original_path, filename, extension, deletion_time,
      mime_type, category, origin_root, project_root,
      storage_path, size, hash, is_restored, active_days, pinned
    ) VALUES (
      '$(sql_escape "$uuid")',
      '$(sql_escape "$abs")',
      '$(sql_escape "$name")',
      '',
      $ts,
      'inode/directory',
      'directory',
      '$(sql_escape "$origin")',
      '$(sql_escape "${project:-}")',
      '$(sql_escape "$manifest")',
      $size,
      'DIR',
      0,
      0,
      0
    );
    COMMIT;" || {
        echo "Directory DB insert failed → rollback"

        rm -f "$manifest"
        rm -rf "$tmpdir"
        continue
    }

    # -------- DELETE ONLY AFTER SUCCESS --------
    rm -rf -- "$target"

    # cleanup
    rm -rf "$tmpdir"

    sync
    continue
fi
    # MIME + category
    mime=$(file --mime-type -b -- "$target" 2>/dev/null)
    [ -z "$mime" ] && mime="application/octet-stream"

    case "$mime" in
        image/*) category="image" ;;
        text/*) category="document" ;;
        video/*) category="video" ;;
        application/zip|application/x-tar) category="archive" ;;
        *) category="other" ;;
    esac

    size=$(stat -c%s "$target" 2>/dev/null || du -sb -- "$target" | awk '{print $1}')
    

    # STEP 1 and 2:
hash=$(sha256sum "$target" | awk '{print $1}')
tmp=$(mktemp)
cp -- "$target" "$tmp" || {
    echo "Copy failed for $target"
    rm -f "$tmp"
    continue
}

# STEP 3: CAS path
hash_dir="$OBJ/${hash:0:2}/${hash:2:2}"
mkdir -p "$hash_dir"
dest="$hash_dir/$hash"

# STEP 4: deduplication
created=0
if ! mv -n -- "$tmp" "$dest" 2>/dev/null; then
    rm -f "$tmp"
    created=0
else
    created=1
fi

uuid=$(cat /proc/sys/kernel/random/uuid)

# STEP 5: DB insert (transactional)
sqlite3 "$DB" "BEGIN;

INSERT INTO trash (
    id, original_path, filename, extension, deletion_time,
    mime_type, category, origin_root, project_root,
    storage_path, size, hash, is_restored, active_days, pinned
) VALUES (
    '$(sql_escape "$uuid")',
    '$(sql_escape "$abs")',
    '$(sql_escape "$name")',
    '$(sql_escape "$ext")',
    $ts,
    '$(sql_escape "$mime")',
    '$(sql_escape "$category")',
    '$(sql_escape "$origin")',
    '$(sql_escape "${project:-}")',
    '$(sql_escape "$dest")',
    $size,
    '$(sql_escape "$hash")',
    0,
    0,
    0
);

COMMIT;" || {
    # rollback (strict)
    if [ -f "$dest" ]; then
      cp -- "$dest" "$target"
    else
      cp -- "$tmp" "$target"
    fi || {
      echo "CRITICAL: rollback failed for $target"
      continue
    }
    echo "DB insert failed → restored file"
    continue
}
rm -f -- "$target"
# ================= DURABILITY =================
sync
done
