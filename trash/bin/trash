#!/usr/bin/env bash
set -euo pipefail

get_object_path() {
    local hash="$1"
    echo "$OBJ/${hash:0:2}/${hash:2:2}/$hash"
}

# ================= CONFIG =================
[ -f "$HOME/.config/trash-system/env" ] && source "$HOME/.config/trash-system/env"

BASE="${TRASH_BASE:-$HOME/.local/share/trash-system}"
DB="${TRASH_DB:-$BASE/db/trash.db}"
OBJ="${TRASH_OBJECTS:-$BASE/objects}"
LOCK="$BASE/.lock"

mkdir -p "$BASE" "$OBJ" "$(dirname "$DB")"

# ================= DB INTEGRITY CHECK =================
if ! sqlite3 "$DB" "PRAGMA integrity_check;" | grep -q ok; then
    echo "ERROR: DB corrupted, attempting recovery..."

    ts=$(date +%s)
    mv "$DB" "$DB.corrupt.$ts" 2>/dev/null || true

    bash "$HOME/dotfiles/trash/scripts/init-db.sh"

    echo "New DB initialized. Old DB preserved as trash.db.corrupt.$ts"
    exit 1
fi

# ================= LOCK =================
exec 200>"$LOCK"
if ! flock -w 2 200; then
    echo "ERROR: lock timeout"
    exit 1
fi

# ================= UTIL =================

fail() {
    echo "ERROR: $1" >&2
    exit 1
}

get_row_by_prefix() {
    sqlite3 -separator '|' "$DB" "
    SELECT id, original_path, storage_path, hash, size
    FROM trash
    WHERE id LIKE '$1%' AND is_restored=0;" | \
    while IFS='|' read -r id orig store hash size; do

        path=$(get_object_path "$hash")

        if [ -f "$path" ]; then
            echo "$id|$orig|$store|$hash|$size"
            return 0
        else
            # auto-clean stale entry
            sqlite3 "$DB" "DELETE FROM trash WHERE id='$id';"
        fi
    done
}

ref_count() {
    sqlite3 "$DB" "
    SELECT COUNT(*) FROM trash
    WHERE hash='$1' AND is_restored=0;"
}

safe_delete_object() {
    local hash="$1"
    local path
    path=$(get_object_path "$hash")

    count=$(ref_count "$hash")

    if [ "$count" -eq 0 ]; then
        [ -e "$path" ] && rm -rf -- "$path"
    fi
}

verify_object() {
    local path="$1"
    local expected="$2"

    [ ! -f "$path" ] && fail "object missing"

    local actual
    actual=$(sha256sum "$path" | awk '{print $1}')

    if [ "$actual" != "$expected" ]; then
      fail "hash mismatch (corruption)"
    fi
}



# ================= COMMANDS =================

case "${1:-}" in

list)
    echo "no     id        filename                         datetime              category"
    echo "--  --------  ------------------------------  --------------------  --------"

    i=1
    sqlite3 -separator '|' "$DB" "
    SELECT id, filename, deletion_time, category
    FROM trash WHERE is_restored=0
    ORDER BY deletion_time DESC;" | \
    while IFS='|' read -r id filename deletion_time category; do

        hash=$(sqlite3 "$DB" "SELECT hash FROM trash WHERE id='$id';")
        path=$(get_object_path "$hash")

        if [ -f "$path" ]; then
            printf "%2d  %-8s  %-30s  %-20s  %s\n" \
                "$i" "${id:0:8}" "$filename" \
                "$(date -d @$deletion_time '+%F %T')" \
                "$category"
            i=$((i+1))
        else
            sqlite3 "$DB" "DELETE FROM trash WHERE id='$id';"
        fi
    done
    ;;

search)
    shift
    query="SELECT substr(id,1,8), filename, datetime(deletion_time,'unixepoch'), category
           FROM trash WHERE is_restored=0"

    while [ $# -gt 0 ]; do
        case "$1" in
            --name) query="$query AND filename LIKE '%$2%'" ; shift 2 ;;
            --type) query="$query AND extension='$2'" ; shift 2 ;;
            --cat)  query="$query AND category='$2'" ; shift 2 ;;
            --path) query="$query AND original_path LIKE '%$2%'" ; shift 2 ;;
            --from) query="$query AND deletion_time >= strftime('%s','$2')" ; shift 2 ;;
            --to)   query="$query AND deletion_time <= strftime('%s','$2')" ; shift 2 ;;
            *) shift ;;
        esac
    done

    sqlite3 -column -header "$DB" "$query ORDER BY deletion_time DESC;"
    ;;

delete)
    arg="${2:-}"
    [ -z "$arg" ] && fail "missing id"

    # ---------- RANGE DELETE ----------
    if [[ "$arg" =~ ^[0-9]+-[0-9]+$ ]]; then
        start=${arg%-*}
        end=${arg#*-}

        ids=$(sqlite3 "$DB" "
        SELECT id FROM (
            SELECT id,
                   ROW_NUMBER() OVER (ORDER BY deletion_time DESC) rn
            FROM trash
            WHERE is_restored=0
        ) WHERE rn BETWEEN $start AND $end;
        ")

        [ -z "$ids" ] && fail "empty range"

        read -p "Confirm delete $start-$end? (y/N): " c
        [ "$c" != "y" ] && exit 0

        for id in $ids; do
            pinned=$(sqlite3 "$DB" "SELECT COALESCE(pinned,0) FROM trash WHERE id='$id';")

            if [ "$pinned" -eq 1 ]; then
                echo "Skipping pinned: ${id:0:8}"
                continue
            fi

            row=$(sqlite3 -separator '|' "$DB" \
                "SELECT id, hash FROM trash WHERE id='$id';")

            hash=$(cut -d'|' -f2 <<< "$row")

            sqlite3 "$DB" "DELETE FROM trash WHERE id='$id';"
            safe_delete_object "$hash"
        done

        echo "Deleted range (excluding pinned)"
        exit 0
    fi

    # ---------- SINGLE DELETE ----------
    row=$(get_row_by_prefix "$arg")
    [ -z "$row" ] && fail "not found"

    id=$(cut -d'|' -f1 <<< "$row")

    pinned=$(sqlite3 "$DB" "SELECT COALESCE(pinned,0) FROM trash WHERE id='$id';")

    if [ "$pinned" -eq 1 ]; then
        echo "ERROR: item is pinned. Unpin before deleting."
        exit 1
    fi

    read -p "Delete permanently? (y/N): " c
    [ "$c" != "y" ] && exit 0

    hash=$(cut -d'|' -f4 <<< "$row")

    sqlite3 "$DB" "DELETE FROM trash WHERE id='$id';"
    safe_delete_object "$hash"

    echo "Deleted"
    ;;

restore)
    row=$(get_row_by_prefix "${2:-}")
    [ -z "$row" ] && fail "not found"

    id=$(cut -d'|' -f1 <<< "$row")
    orig=$(cut -d'|' -f2 <<< "$row")
    hash=$(cut -d'|' -f4 <<< "$row")
    store=$(get_object_path "$hash")

    if [ ! -f "$store" ]; then
      echo "ERROR: object missing → $hash"
      echo "Fix: run 'trash repair'"
      exit 1
    fi

    verify_object "$store" "$hash"

    [ -e "$orig" ] && fail "target exists"

    mkdir -p "$(dirname "$orig")"

    echo "RESTORE: $store -> $orig"
    cp -v -- "$store" "$orig" || fail "copy failed"
    sqlite3 "$DB" "UPDATE trash SET is_restored=1 WHERE id='$id';" || {
      rm -f "$orig"
      fail "DB update failed after restore"
    }

echo "Restored"
    ;;

undo)
    id=$(sqlite3 "$DB" "
    SELECT id FROM trash
    WHERE is_restored=0
    ORDER BY deletion_time DESC LIMIT 1;")

    [ -z "$id" ] && exit 0

    "$0" restore "$id"
    ;;

stats)
    sqlite3 "$DB" "
    SELECT COUNT(*), ROUND(SUM(size)/1024/1024,2)
    FROM trash WHERE is_restored=0;"
    ;;

group)
    sqlite3 "$DB" "
    SELECT extension, COUNT(*)
    FROM trash
    WHERE is_restored=0
    GROUP BY extension;"
    ;;

pin)
    sqlite3 "$DB" "UPDATE trash SET pinned=1 WHERE id LIKE '$2%';"
    ;;

unpin)
    sqlite3 "$DB" "UPDATE trash SET pinned=0 WHERE id LIKE '$2%';"
    ;;

cleanup)
    # configurable days (default 100)
    days="${2:-100}"
    cutoff=$(date -d "-$days days" +%s)

    sqlite3 -separator '|' "$DB" "
    SELECT id, hash FROM trash
    WHERE is_restored=0
    AND COALESCE(pinned,0)=0
    AND deletion_time < $cutoff
    AND COALESCE(pinned,0)=0;" | \
    while IFS='|' read -r id hash; do
        echo "Cleaning: $id"
        sqlite3 "$DB" "DELETE FROM trash WHERE id='$id';"
        safe_delete_object "$hash"
    done

    echo "Cleanup complete (>$days days)"
    ;;

health)
    sqlite3 "$DB" "PRAGMA integrity_check;" | grep -q ok || {
        echo "ERROR: DB corrupted"
        exit 1
    }

    find "$OBJ" -type f >/dev/null 2>&1 || {
        echo "ERROR: object store inaccessible"
        exit 1
    }

    echo "OK"
    ;;

clear)
    read -p "Permanently delete ALL trash? (y/N): " c
    [ "$c" != "y" ] && exit 0

    sqlite3 "$DB" "DELETE FROM trash;"

    rm -rf "$OBJ"/*
    mkdir -p "$OBJ"

    echo "Trash fully cleared"
    ;;

scan)
    echo "Scanning for orphan objects..."

    find "$OBJ" -type f | while read -r path; do
        hash=$(basename "$path")

        count=$(sqlite3 "$DB" \
            "SELECT COUNT(*) FROM trash WHERE hash='$hash' AND is_restored=0;")

        if [ "$count" -eq 0 ]; then
            echo "Removing orphan: $hash"
            rm -f "$path"
        fi
    done

    echo "Scan complete"
    ;;

*)
    echo "Usage: trash [list|search|delete|restore|undo|stats|group|pin|unpin]"
    exit 1
    ;;

esac
