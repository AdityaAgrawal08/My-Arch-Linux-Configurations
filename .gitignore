# ---------------------------
# System / Editor
# ---------------------------
.DS_Store
*.swp
*.swo

# ---------------------------
# Logs / Runtime state
# ---------------------------
*.log
logs/
state/
.cache/

# ---------------------------
# Python (pdfmerge etc.)
# ---------------------------
__pycache__/
*.pyc

# ---------------------------
# Package build artifacts (Arch)
# ---------------------------
*.pkg.tar.zst
*.pkg.tar.zst.sig

# ---------------------------
# Environments (explicit only)
# ---------------------------
.local/share/*/venv/

# ---------------------------
# Node (future-proof)
# ---------------------------
node_modules/

# ---------------------------
# Fish runtime state
# ---------------------------
fish/.config/fish/fish_variables

# ---------------------------
# Backup files
# ---------------------------
*.backup

trash/.local/
*.db
*.lock
